# Copy to .env and edit. Never commit .env.

# "caddy" starts Caddy with automatic TLS for DOMAIN. Empty it for gateway mode.
COMPOSE_PROFILES=caddy

# Public name Caddy obtains a certificate for. Ignored in gateway mode.
DOMAIN=explorer.example.com

# Where the explorer port is published on the host.
# Caddy mode: keep 127.0.0.1 (Caddy reaches the container over the compose network).
# Gateway mode: an address your gateway can reach.
EXPLORER_BIND=127.0.0.1
EXPLORER_PORT=8080

# Image to run. Leave as is to build locally with `docker compose build`.
EXPLORER_IMAGE=code-explorer:local

# SSH keys as secret files (deploy keys, access keys) are the recommended way to reach private repos.
# This env token is the optional HTTPS alternative, referenced by config.toml as env = "DESIGN_SYSTEM_TOKEN".
DESIGN_SYSTEM_TOKEN=replace-me

# Compose network for explorer and Caddy.
EDGE_SUBNET=172.30.0.0/24
# Dynamic addresses come from this half of the subnet so CADDY_IP in the other half is never taken first.
EDGE_IP_RANGE=172.30.0.128/25

# Fixed address of Caddy on that network. Put it in server.trusted_proxies as a /32 and trust nothing else:
# the bridge gateway (.1) is how clients on the Docker host appear, and they must not be able to set X-Forwarded-For.
CADDY_IP=172.30.0.2
